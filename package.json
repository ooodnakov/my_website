{
  "name": "unified-site",
  "private": true,
  "scripts": {
    "build": "npm run --prefix apps/main build",
    "build:cv": "npm run --prefix apps/cv-site build",
    "build:legacy": "npm run --prefix apps/legacy_rewored build",
    "check": "npm run --prefix apps/main check",
    "lint": "npm run --prefix apps/cv-site lint",
    "test": "npm run --prefix apps/cv-site test",
    "validate": "npm run check && npm run lint && npm run test && npm run build"
  }
}
