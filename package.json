{
  "name": "unified-site",
  "private": true,
  "scripts": {
    "build": "pnpm --dir apps/main build",
    "build:cv": "pnpm --dir apps/cv-site build",
    "build:legacy": "pnpm --dir apps/legacy_rewored build",
    "check": "pnpm --dir apps/main check",
    "lint": "pnpm --dir apps/cv-site lint",
    "test": "pnpm --dir apps/cv-site test",
    "validate": "pnpm check && pnpm lint && pnpm test && pnpm build"
  }
}
