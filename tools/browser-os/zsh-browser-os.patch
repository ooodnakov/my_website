@@ -86,9 +86,29 @@
 /**/
 #endif /* __CYGWIN__ */
 
+static void
+protect_browser_os_control_fd(void)
+{
+    char *text = getenv("ZSH_BROWSER_OS_CONTROL_FD");
+    char *end;
+    long fd;
+    int flags;
+
+    if (!text || !*text)
+	return;
+    errno = 0;
+    fd = strtol(text, &end, 10);
+    if (errno || *end || fd <= 2 || fd > 65535)
+	return;
+    flags = fcntl((int)fd, F_GETFD);
+    if (flags >= 0)
+	(void)fcntl((int)fd, F_SETFD, flags | FD_CLOEXEC);
+}
+
 /**/
 int
 main(int argc, char **argv)
 {
+    protect_browser_os_control_fd();
     return (zsh_main(argc, argv));
 }
