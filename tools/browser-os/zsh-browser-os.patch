+	!zlell && !zlecs && !kungetct && !browser_os_multibyte_pending &&
+	!localkeymap && curkeymapname && !strcmp(curkeymapname, "main") &&
+	!incompctlfunc && !errflag && !retflag && !breaks && !exit_pending &&
+	tcgetpgrp(SHTTY) == mypgrp;
+}
+static int browser_os_control_fd = -1;
+
+static void
+browser_os_report_safe_point(void)
+{
+    unsigned char record[24];
+    unsigned long long ordinal = browser_os_input_ordinal;
+    unsigned long long generation = browser_os_editor_generation;
+    int i;
+
+    if (browser_os_control_fd < 0)
+	return;
+    memcpy(record, "BOSZ", 4);
+    record[4] = 2;
+    record[5] = 1;
+    record[6] = browser_os_clean_prompt() ? 1 : 0;
+    record[7] = 0;
+    for (i = 15; i >= 8; i--) {
+	record[i] = ordinal & 0xff;
+	ordinal >>= 8;
+    }
+    for (i = 23; i >= 16; i--) {
+	record[i] = generation & 0xff;
+	generation >>= 8;
+    }
+    if (send(browser_os_control_fd, record, sizeof(record), MSG_NOSIGNAL) !=
+	sizeof(record)) {
+	close(browser_os_control_fd);
+	browser_os_control_fd = -1;
+    }
+}
