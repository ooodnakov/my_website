# Host-side settings (no secrets required by this stack).

# Address on the host that the website port is published to.
# Keep the loopback default when a reverse proxy runs on the same host;
# set to 0.0.0.0 to publish directly.
WEBSITE_BIND=127.0.0.1

# Host port mapped to the website container (the container always listens on 5000).
HOST_PORT=8082

# Container timezone.
TZ=UTC

# Optional. Public base URL used at build time to absolutize og:image / twitter:image URLs.
# Example: https://example.com
SITE_URL=

# Secrets: none are required. Runtime state is in-memory and the app reads no
# credential environment variables. If DATABASE_URL or session secrets are ever
# added, define them here (never commit real values) and pass them through the
# `environment:` section in docker-compose.yaml.
